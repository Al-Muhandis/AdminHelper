/var/log/tgadmin/*.log {
    weekly
    rotate 8
    maxsize 50M
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        # the restart reopens both log files; the daemon shuts down gracefully
        # and saves the spam filter base on SIGTERM
        systemctl restart tgadmin >/dev/null 2>&1 || true
    endscript
}
